# Server Configuration
PORT=5001

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/gharmb

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration (for Property Image/Video Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway Configuration (for Subscription/Premium Listings)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
